# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and should NEVER be committed.

# ── LLM API keys ─────────────────────────────────────────────────────────────
# Qwen (DashScope) — used by LLM_task_plan.py with the Qwen model
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek — alternative LLM backend
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PiperX semantic VLM ──────────────────────────────────────────────────────
# Multimodal model used by main_piperx_vision.py.  DeepSeek currently serves
# vision input through deepseek-flash at the base URL below.
PIPERX_VLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PIPERX_VLM_BASE_URL=https://api.deepseek.com
PIPERX_VLM_MODEL=deepseek-flash

# ── Optional path overrides ───────────────────────────────────────────────────
# Directory that contains downloaded model weights.
# Defaults to the "weights/" subfolder inside this repository.
# WEIGHTS_DIR=/path/to/your/weights

# Root directory for captured RealSense frames (rgb / depth / mask sub-dirs).
# Defaults to "data/" inside this repository (see configs/real_piper.yaml).
# DATA_DIR=/path/to/your/data
